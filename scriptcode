local function RefreshCharacter()

    Character = LocalPlayer.Character

    if not Character then
        return false
    end

    Humanoid =
        Character:FindFirstChildOfClass("Humanoid")

    Root =
        Character:FindFirstChild("HumanoidRootPart")

    return Humanoid ~= nil and Root ~= nil
end

