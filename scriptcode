--==================================================
-- TARGET
--==================================================


local function SetTarget(player)

    PlayerTools.Target =
    player


    Yamin.Notify(
        "Target",
        "Selected "..player.Name
    )

end



--==================================================
-- POSITION SYSTEM
--==================================================


local function StopModes()

    PlayerTools.Stalk =
    false

    PlayerTools.Headsit =
    false

    PlayerTools.Follow =
    false

    PlayerTools.Orbit =
    false


end



PositionConnection =
RunService.RenderStepped:Connect(
function(dt)



    local target =
    PlayerTools.Target



    if not target then
        return
    end



    local targetRoot =
    GetRoot(target)



    local myRoot =
    GetRoot(LocalPlayer)



    if not targetRoot
    or not myRoot then

        return

    end



    -- STALK

    if PlayerTools.Stalk then


        local pos =
        targetRoot.Position
        -
        targetRoot.CFrame.LookVector
        *
        3



        myRoot.CFrame =
        CFrame.lookAt(
            pos,
            targetRoot.Position
        )



    -- HEADSIT

    elseif PlayerTools.Headsit then


        myRoot.CFrame =
        CFrame.new(
            targetRoot.Position
            +
            Vector3.new(
                0,
                3.5,
                0
            )
        )



    -- FOLLOW

    elseif PlayerTools.Follow then


        local pos =
        targetRoot.Position
        -
        targetRoot.CFrame.LookVector
        *
        6



        myRoot.CFrame =
        CFrame.lookAt(
            pos,
            targetRoot.Position
        )



    -- ORBIT

    elseif PlayerTools.Orbit then


        local angle =
        tick()*2



        local offset =
        Vector3.new(

            math.cos(angle)
            *
            PlayerTools.OrbitDistance,

            3,

            math.sin(angle)
            *
            PlayerTools.OrbitDistance

        )



        myRoot.CFrame =
        CFrame.lookAt(
            targetRoot.Position
            +
            offset,

            targetRoot.Position
        )

    end


end)



