    CurrentFlyState = ""

    if AuraSettings.AuraFly then
        SetFlyAnimation("Hover")
    else
        PlayPackAnimation("Idle")
    end

    Yamin.Notify(
        "Aura",
        packName .. " selected."
    )

end

