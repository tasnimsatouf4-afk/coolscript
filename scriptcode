--==================================================
-- CHARACTER
--==================================================

local function Character()

    return Player.Character

end



local function Humanoid()

    local char =
    Character()

    if char then

        return char:FindFirstChildOfClass(
            "Humanoid"
        )

    end

end



local function Apply()


    local hum =
    Humanoid()


    if hum then

        hum.WalkSpeed =
        Movement.Speed


        hum.JumpPower =
        Movement.Jump

    end

end



Player.CharacterAdded:Connect(
function()

    task.wait(1)

    Apply()

end)



--==================================================
-- INFINITE JUMP
--==================================================

UserInputService.JumpRequest:Connect(
function()


    if Movement.InfiniteJump then


        local hum =
        Humanoid()


        if hum then

            hum:ChangeState(
            Enum.HumanoidStateType.Jumping
            )

        end


    end


end)



--==================================================
-- NOCLIP
--==================================================

RunService.Stepped:Connect(
function()


    if not Movement.Noclip then
        return
    end



    local char =
    Character()


    if char then


        for _,v in pairs(
            char:GetDescendants()
        ) do


            if v:IsA(
            "BasePart"
            ) then


                v.CanCollide=false


            end


        end


    end


end)



