local Settings = {

    ToggleKey =
    Enum.KeyCode.RightShift,

    Visible =
    true,

    Notifications =
    true

}



--==================================================
-- GUI TOGGLE
--==================================================


local function ToggleHub()


    Settings.Visible =
    not Settings.Visible



    local gui =
    LocalPlayer.PlayerGui:FindFirstChild(
        "YaminHub"
    )


    if gui then


        for _,v in pairs(
            gui:GetChildren()
        ) do


            if v:IsA("ScreenGui") then

                v.Enabled =
                Settings.Visible

            end


        end

    end



end



UserInputService.InputBegan:Connect(
function(input,gpe)


    if gpe then
        return
    end



    if input.KeyCode ==
    Settings.ToggleKey then


        ToggleHub()


    end


end)



--==================================================
-- NOTIFY SYSTEM
--==================================================


function Yamin.SafeNotify(title,text)


    if Settings.Notifications then

        Yamin.Notify(
            title,
            text
        )

    end


end



--==================================================
-- CHARACTER RESET
--==================================================


local function Respawn()


    local char =
    LocalPlayer.Character


    if char then


        local hum =
        char:FindFirstChildOfClass(
            "Humanoid"
        )


        if hum then

            hum.Health = 0

        end


    end


end



--==================================================
-- SERVER REJOIN
--==================================================


local function Rejoin()


    TeleportService:Teleport(
        game.PlaceId,
        LocalPlayer
    )


end



--==================================================
-- CLEANUP
--==================================================


local function Cleanup()


    -- stop connections

    for _,v in pairs(
        getconnections(
            game:GetService("RunService")
            .Heartbeat
        )
    ) do

        pcall(function()

            v:Disable()

        end)

    end



    -- remove temporary objects


    for _,v in pairs(
        workspace:GetChildren()
    ) do


        if v.Name ==
        "YaminAir" then


            v:Destroy()


        end


    end



    Yamin.SafeNotify(
        "Yamin HUB",
        "Cleaned"
    )


end



