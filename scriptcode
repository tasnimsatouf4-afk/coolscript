--==================================================
-- BUTTON
--==================================================

function Yamin.Button(
    Parent,
    Text,
    Callback
)


    local Button =
    Instance.new("TextButton")


    Button.Size =
    UDim2.new(
        1,
        -30,
        0,
        42
    )


    Button.Position =
    UDim2.fromOffset(
        15,
        0
    )


    Button.BackgroundColor3 =
    Yamin.Theme.Accent


    Button.Text =
    Text


    Button.TextColor3 =
    Color3.fromRGB(
        255,
        255,
        255
    )


    Button.Font =
    Enum.Font.GothamSemibold


    Button.TextSize =
    15


    Button.AutoButtonColor = false


    Button.Parent =
    Parent



    local Corner =
    Instance.new("UICorner")


    Corner.CornerRadius =
    UDim.new(
        0,
        10
    )


    Corner.Parent =
    Button



    Button.MouseEnter:Connect(function()


        TweenService:Create(
            Button,
            TweenInfo.new(
                .2
            ),
            {
                BackgroundColor3 =
                Yamin.Theme.Accent2
            }

        ):Play()


    end)



    Button.MouseLeave:Connect(function()


        TweenService:Create(
            Button,
            TweenInfo.new(
                .2
            ),
            {
                BackgroundColor3 =
                Yamin.Theme.Accent
            }

        ):Play()


    end)



    Button.MouseButton1Click:Connect(function()


        if Callback then

            Callback()

        end


    end)



    return Button

end




--==================================================
-- TOGGLE
--==================================================

function Yamin.Toggle(
    Parent,
    Text,
    Default,
    Callback
)


    local State =
    Default or false



    local Holder =
    Instance.new("Frame")


    Holder.Size =
    UDim2.new(
        1,
        -30,
        0,
        42
    )


    Holder.Position =
    UDim2.fromOffset(
        15,
        0
    )


    Holder.BackgroundColor3 =
    Yamin.Theme.Background


    Holder.Parent =
    Parent




    local Corner =
    Instance.new("UICorner")
    
    Corner.CornerRadius =
    UDim.new(0,10)

    Corner.Parent =
    Holder




    local Label =
    Instance.new("TextLabel")


    Label.Size =
    UDim2.new(
        .6,
        0,
        1,
        0
    )


    Label.BackgroundTransparency =
    1


    Label.Text =
    Text


    Label.TextColor3 =
    Yamin.Theme.Text


    Label.Font =
    Enum.Font.Gotham


    Label.TextSize =
    15


    Label.TextXAlignment =
    Enum.TextXAlignment.Left


    Label.Position =
    UDim2.fromOffset(
        12,
        0
    )


    Label.Parent =
    Holder




    local Toggle =
    Instance.new("TextButton")


    Toggle.Size =
    UDim2.fromOffset(
        70,
        28
    )


    Toggle.Position =
    UDim2.new(
        1,
        -85,
        .5,
        -14
    )
    
    
    Toggle.AutoButtonColor = false


    Toggle.Text =
    State and "ON" or "OFF"


    Toggle.BackgroundColor3 =
    State and
    Yamin.Theme.Accent
    or
    Yamin.Theme.Card


    Toggle.TextColor3 =
    Yamin.Theme.Text


    Toggle.Parent =
    Holder



    local ToggleCorner =
    Instance.new("UICorner")
    
    ToggleCorner.CornerRadius =
    UDim.new(0,8)


    ToggleCorner.Parent =
    Toggle




    Toggle.MouseButton1Click:Connect(function()


        State =
        not State



        Toggle.Text =
        State and "ON" or "OFF"



        Toggle.BackgroundColor3 =
        State and
        Yamin.Theme.Accent
        or
        Yamin.Theme.Card



        if Callback then

            Callback(State)

        end


    end)



    return Holder

end
