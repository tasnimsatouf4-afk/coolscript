--==================================================
-- ANIMATION ENGINE
--==================================================

local CurrentTrack

local function StopAnimation()

    if CurrentTrack then

        pcall(function()
            CurrentTrack:Stop(0.15)
            CurrentTrack:Destroy()
        end)

        CurrentTrack = nil

    end

end

local function PlayAnimation(id, looped)

    if not Humanoid or not id then
        return
    end

    local Animator =
        Humanoid:FindFirstChildOfClass("Animator")

    if not Animator then

        Animator = Instance.new("Animator")
        Animator.Parent = Humanoid

    end

    StopAnimation()

    local Animation =
        Instance.new("Animation")

    Animation.AnimationId =
        "rbxassetid://" .. tostring(id)

    local success, track =
        pcall(function()
            return Animator:LoadAnimation(Animation)
        end)

    if not success or not track then
        Animation:Destroy()
        return
    end

    track.Priority =
        Enum.AnimationPriority.Action

    track.Looped =
        looped ~= false

    track:Play(0.15)

    CurrentTrack = track

end

--==================================================
-- CURRENT PACK ANIMATION
--==================================================

local function GetPack()

    return AnimationPacks[
        AuraSettings.ActivePack
    ]

end

local function PlayPackAnimation(name)

    local pack = GetPack()

    if not pack then
        return
    end

    local id = pack[name]

    if id then
        PlayAnimation(id, true)
    end

end

--==================================================
-- FLY ANIMATION STATE
--==================================================

local CurrentFlyState = ""

local function SetFlyAnimation(state)

    if CurrentFlyState == state then
        return
    end

    CurrentFlyState = state

    local pack = GetPack()

    if not pack then
        return
    end

    -- Map flight states to the animation pack

    if state == "Hover" then

        PlayPackAnimation("Idle")

    elseif state == "Forward" then

        PlayPackAnimation("Run")

    elseif state == "Backward" then

        PlayPackAnimation("Walk")

    elseif state == "Left" then

        PlayPackAnimation("Walk")

    elseif state == "Right" then

        PlayPackAnimation("Walk")

    elseif state == "Up" then

        PlayPackAnimation("Jump")

    elseif state == "Down" then

        PlayPackAnimation("Fall")

    end

end

