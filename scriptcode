local function CreateToggle(parent, text, default, callback)
    local Button = Create("TextButton", {
        Parent = parent,

        Size = UDim2.new(1, 0, 0, 48),

        BackgroundColor3 = Config.Colors.Card,
        BorderSizePixel = 0,

        Text = "",

        AutoButtonColor = false,
    })

    Corner(Button, 8)

    local Label = Create("TextLabel", {
        Parent = Button,

        Position = UDim2.fromOffset(15, 0),
        Size = UDim2.new(1, -80, 1, 0),

        BackgroundTransparency = 1,

        Text = text,

        TextColor3 = Config.Colors.Text,

        Font = Enum.Font.GothamMedium,
        TextSize = 12,

        TextXAlignment = Enum.TextXAlignment.Left,
    })

    local ToggleBackground = Create("Frame", {
        Parent = Button,

        Position = UDim2.new(1, -55, 0.5, -10),
        Size = UDim2.fromOffset(40, 20),

        BackgroundColor3 = Color3.fromRGB(45, 45, 50),
        BorderSizePixel = 0,
    })

    Corner(ToggleBackground, 20)

    local ToggleCircle = Create("Frame", {
        Parent = ToggleBackground,

        Position = UDim2.fromOffset(3, 3),
        Size = UDim2.fromOffset(14, 14),

        BackgroundColor3 = Color3.fromRGB(180, 180, 185),
        BorderSizePixel = 0,
    })

    Corner(ToggleCircle, 50)

    local enabled = default or false

    local function Update()
        if enabled then
            Tween(ToggleBackground, {
                BackgroundColor3 = Config.Colors.Accent
            })

            Tween(ToggleCircle, {
                Position = UDim2.new(1, -17, 0, 3),
                BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            })
        else
            Tween(ToggleBackground, {
                BackgroundColor3 = Color3.fromRGB(45, 45, 50)
            })

            Tween(ToggleCircle, {
                Position = UDim2.fromOffset(3, 3),
                BackgroundColor3 = Color3.fromRGB(180, 180, 185)
            })
        end
    end

    Button.MouseEnter:Connect(function()
        Tween(Button, {
            BackgroundColor3 = Config.Colors.CardHover
        }, 0.15)
    end)

    Button.MouseLeave:Connect(function()
        Tween(Button, {
            BackgroundColor3 = Config.Colors.Card
        }, 0.15)
    end)

    Button.MouseButton1Click:Connect(function()
        enabled = not enabled

        Update()

        if callback then
            callback(enabled)
        end
    end)

    Update()

    return Button, function()
        return enabled
    end
end

