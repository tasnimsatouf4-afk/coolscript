    local Corner =
    Instance.new("UICorner")

    Corner.Parent =
    Holder




    local Label =
    Instance.new("TextLabel")


    Label.Size =
    UDim2.new(
        .6,
        0,
        1,
        0
    )


    Label.BackgroundTransparency =
    1


    Label.Text =
    Text


    Label.TextColor3 =
    Yamin.Theme.Text


    Label.Font =
    Enum.Font.Gotham


    Label.TextSize =
    15


    Label.TextXAlignment =
    Enum.TextXAlignment.Left


    Label.Position =
    UDim2.fromOffset(
        12,
        0
    )


    Label.Parent =
    Holder




    local Toggle =
    Instance.new("TextButton")


    Toggle.Size =
    UDim2.fromOffset(
        70,
        28
    )


    Toggle.Position =
    UDim2.new(
        1,
        -85,
        .5,
        -14
    )


    Toggle.Text =
    State and "ON" or "OFF"


    Toggle.BackgroundColor3 =
    State and
    Yamin.Theme.Accent
    or
    Yamin.Theme.Card


    Toggle.TextColor3 =
    Yamin.Theme.Text


    Toggle.Parent =
    Holder



    local ToggleCorner =
    Instance.new("UICorner")


    ToggleCorner.Parent =
    Toggle




    Toggle.MouseButton1Click:Connect(function()


        State =
        not State



        Toggle.Text =
        State and "ON" or "OFF"



        Toggle.BackgroundColor3 =
        State and
        Yamin.Theme.Accent
        or
        Yamin.Theme.Card



        if Callback then

            Callback(State)

        end


    end)



    return Holder

end





--==================================================
-- SLIDER
--==================================================

function Yamin.Slider(
    Parent,
    Text,
    Minimum,
    Maximum,
    Default,
    Callback
)


    local Value =
    Default



    local Holder =
    Instance.new("Frame")


    Holder.Size =
    UDim2.new(
        1,
        -30,
        0,
        65
    )


    Holder.Position =
    UDim2.fromOffset(
        15,
        0
    )


    Holder.BackgroundColor3 =
    Yamin.Theme.Background


    Holder.Parent =
    Parent



    local Corner =
    Instance.new("UICorner")


    Corner.Parent =
    Holder




    local Label =
    Instance.new("TextLabel")


    Label.Size =
    UDim2.new(
        1,
        -20,
        0,
        25
    )


    Label.Position =
    UDim2.fromOffset(
        10,
        5
    )


    Label.BackgroundTransparency =
    1


    Label.Text =
    Text..": "..Value


    Label.TextColor3 =
    Yamin.Theme.Text


    Label.Font =
    Enum.Font.Gotham


    Label.TextSize =
    15


    Label.TextXAlignment =
    Enum.TextXAlignment.Left


    Label.Parent =
    Holder




    local Bar =
    Instance.new("Frame")


    Bar.Size =
    UDim2.new(
        .9,
        0,
        0,
        8
    )


    Bar.Position =
    UDim2.new(
        .05,
        0,
        .7,
        0
    )


    Bar.BackgroundColor3 =
    Yamin.Theme.Card


    Bar.Parent =
    Holder




    local Fill =
    Instance.new("Frame")


    Fill.Size =
    UDim2.new(
        (Value-Minimum)/
        (Maximum-Minimum),
        0,
        1,
        0
    )


    Fill.BackgroundColor3 =
    Yamin.Theme.Accent


    Fill.Parent =
    Bar




    local Dragging = false



    Bar.InputBegan:Connect(function(Input)


        if Input.UserInputType ==
        Enum.UserInputType.MouseButton1 then

            Dragging = true

        end


    end)



    UserInputService.InputEnded:Connect(function(Input)


        if Input.UserInputType ==
        Enum.UserInputType.MouseButton1 then

            Dragging = false

        end


    end)



    UserInputService.InputChanged:Connect(function(Input)


        if Dragging and
        Input.UserInputType ==
        Enum.UserInputType.MouseMovement then


            local Percent =
            math.clamp(
                (
                Input.Position.X -
                Bar.AbsolutePosition.X
                )
                /
                Bar.AbsoluteSize.X,
                0,
                1
            )



            Value =
            math.floor(
                Minimum +
                (
                Maximum-Minimum
                )
                *
                Percent
            )



            Fill.Size =
            UDim2.new(
                Percent,
                0,
                1,
                0
            )



            Label.Text =
            Text..": "..Value



            if Callback then

                Callback(Value)

            end


        end


    end)



    return Holder

end





