--==================================================
-- OPEN SECTION
--==================================================

local CurrentSection

local function OpenSection(name)
    local data

    for _, section in ipairs(SectionData) do
        if section.Name == name then
            data = section
            break
        end
    end

    if not data then
        return
    end

    CurrentSection = name

    SectionTitle.Text = data.Name
    SectionDescription.Text = data.Description

    ClearContent()

    for sectionName, button in pairs(SectionButtons) do
        if sectionName == name then
            Tween(button, {
                BackgroundColor3 = Config.Colors.AccentDark
            }, 0.15)
        else
            Tween(button, {
                BackgroundColor3 = Config.Colors.Sidebar
            }, 0.15)
        end
    end

    if SectionCallbacks[name] then
        SectionCallbacks[name](Scroller)
    end
end

