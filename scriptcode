--==================================================

local FrozenPlayers = {}

local function FreezePlayer(Target)

    if not Target then
        Notify("No player selected.")
        return
    end

    local TargetHumanoid = GetTargetHumanoid(Target)

    if not TargetHumanoid then
        Notify("Target humanoid unavailable.")
        return
    end

    FrozenPlayers[Target] = true

    TargetHumanoid.WalkSpeed = 0
    TargetHumanoid.JumpPower = 0
    TargetHumanoid.AutoRotate = false

    Notify(
        "Frozen: " ..
        Target.DisplayName
    )
end

local function UnfreezePlayer(Target)

    if not Target then
        Notify("No player selected.")
        return
    end

    local TargetHumanoid = GetTargetHumanoid(Target)

    if not TargetHumanoid then
        Notify("Target humanoid unavailable.")
        return
    end

    FrozenPlayers[Target] = nil

    TargetHumanoid.WalkSpeed = 16
    TargetHumanoid.JumpPower = 50
    TargetHumanoid.AutoRotate = true

    Notify(
        "Unfrozen: " ..
        Target.DisplayName
    )
end

