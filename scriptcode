function Yamin.CreateTab(name)


    local Button =
    Instance.new("TextButton")


    Button.Size =
    UDim2.new(
        1,
        -20,
        0,
        40
    )


    Button.Position =
    UDim2.fromOffset(
        10,
        0
    )


    Button.BackgroundColor3 =
    Color3.fromRGB(
        35,
        35,
        50
    )


    Button.Text =
    name


    Button.TextColor3 =
    Color3.new(
        1,
        1,
        1
    )


    Button.Parent =
    Sidebar



    local Page =
    Instance.new("ScrollingFrame")


    Page.Name =
    name


    Page.Size =
    UDim2.fromScale(
        1,
        1
    )


    Page.BackgroundTransparency =
    1


    Page.Visible =
    false


    Page.ScrollBarThickness =
    4


    Page.Parent =
    Pages



    local Layout =
    Instance.new("UIListLayout")


    Layout.Padding =
    UDim.new(
        0,
        10
    )


    Layout.Parent =
    Page



    Yamin.Tabs[name] =
    {
        Button = Button,
        Page = Page
    }



    Button.MouseButton1Click:Connect(function()

        Yamin.OpenTab(name)

    end)



    return Page

end



function Yamin.OpenTab(name)


    for _,tab in pairs(
        Yamin.Tabs
    ) do

        tab.Page.Visible = false

    end



    local tab =
    Yamin.Tabs[name]


    if tab then

        tab.Page.Visible = true

        Yamin.CurrentTab =
        name

    end


end



