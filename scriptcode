--==================================================

local Bundles = {

    Angel = "57393899235237",

    AdidasAura = "4294795",

    AdidasCommunity = "2623795"

}



local function LoadBundle(name)

    local id = Bundles[name]

    if not id then
        return
    end


    pcall(function()

        getgenv().bundle = id

        loadstring(
            game:HttpGet(
            "https://raw.githubusercontent.com/Bac0nHck/Scripts/refs/heads/main/InstantBundle.lua"
            )
        )()

    end)


    Aura.SelectedBundle = name


    Yamin.Notify(
        "Aura",
        name.." loaded"
    )

end



--==================================================
-- AIR WALK FLY
--==================================================


local function StopAuraFly()

    Aura.Fly = false


    if FlyConnection then

        FlyConnection:Disconnect()
        FlyConnection = nil

    end

end



local function StartAuraFly()

    if FlyConnection then
        return
    end


    Aura.Fly = true



    FlyConnection =
    RunService.RenderStepped:Connect(
    function(dt)


        if not Aura.Fly then
            return
        end



        local root = GetRoot()

        local character = GetCharacter()


        if not root or not character then
            return
        end



        local camera =
        workspace.CurrentCamera



        if not camera then
            return
        end



        local movement = Vector3.zero



        -- forward

        if UserInputService:IsKeyDown(
            Enum.KeyCode.W
        ) then

            movement += camera.CFrame.LookVector

        end



        -- backward

        if UserInputService:IsKeyDown(
            Enum.KeyCode.S
        ) then

            movement -= camera.CFrame.LookVector

        end



        -- right

        if UserInputService:IsKeyDown(
            Enum.KeyCode.D
        ) then

            movement += camera.CFrame.RightVector

        end



        -- left

        if UserInputService:IsKeyDown(
            Enum.KeyCode.A
        ) then

            movement -= camera.CFrame.RightVector

        end



        -- up

        if UserInputService:IsKeyDown(
            Enum.KeyCode.Space
        ) then

            movement += Vector3.new(
                0,
                1,
                0
            )

        end



        -- down

        if UserInputService:IsKeyDown(
            Enum.KeyCode.LeftControl
        ) then

            movement -= Vector3.new(
                0,
                1,
                0
            )

        end



        if movement.Magnitude > 0 then

            movement =
            movement.Unit


            -- MOVE ONLY
            -- Roblox handles animations

            root.CFrame =
            root.CFrame +
            movement *
            Aura.Speed *
            dt


        end


    end)

end



