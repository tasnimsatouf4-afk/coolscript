local HighlightEnabled = false
local HighlightObjects = {}

local function AddHighlight(Target)

    if not Target or not Target.Character then
        return
    end

    if HighlightObjects[Target] then
        return
    end

    local Highlight = Instance.new("Highlight")
    Highlight.Name = "YaminHighlight"
    Highlight.FillColor = Config.Accent
    Highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    Highlight.FillTransparency = 0.65
    Highlight.OutlineTransparency = 0
    Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    Highlight.Adornee = Target.Character
    Highlight.Parent = Target.Character

    HighlightObjects[Target] = Highlight
end

local function RemoveHighlight(Target)

    local Highlight = HighlightObjects[Target]

    if Highlight then
        Highlight:Destroy()
        HighlightObjects[Target] = nil
    end
end

local function SetHighlights(Value)

    HighlightEnabled = Value

    for _, Target in ipairs(Players:GetPlayers()) do

        if Target ~= Player then

            if Value then
                AddHighlight(Target)
            else
                RemoveHighlight(Target)
            end
        end
    end
end

Players.PlayerAdded:Connect(function(Target)

    Target.CharacterAdded:Connect(function()

        if HighlightEnabled then
            task.wait(1)
            AddHighlight(Target)
        end
    end)
end)

Players.PlayerRemoving:Connect(function(Target)
    RemoveHighlight(Target)
    FrozenPlayers[Target] = nil
end)

