function Yamin.Button(
    Parent,
    Text,
    Callback
)


    local Button =
    Instance.new("TextButton")


    Button.Size =
    UDim2.new(
        1,
        -30,
        0,
        42
    )


    Button.Position =
    UDim2.fromOffset(
        15,
        0
    )


    Button.BackgroundColor3 =
    Yamin.Theme.Accent


    Button.Text =
    Text


    Button.TextColor3 =
    Color3.fromRGB(
        255,
        255,
        255
    )


    Button.Font =
    Enum.Font.GothamSemibold


    Button.TextSize =
    15


    Button.AutoButtonColor = false


    Button.Parent =
    Parent



    local Corner =
    Instance.new("UICorner")


    Corner.CornerRadius =
    UDim.new(
        0,
        10
    )


    Corner.Parent =
    Button



    Button.MouseEnter:Connect(function()


        TweenService:Create(
            Button,
            TweenInfo.new(
                .2
            ),
            {
                BackgroundColor3 =
                Yamin.Theme.Accent2
            }

        ):Play()


    end)



    Button.MouseLeave:Connect(function()


        TweenService:Create(
            Button,
            TweenInfo.new(
                .2
            ),
            {
                BackgroundColor3 =
                Yamin.Theme.Accent
            }

        ):Play()


    end)



    Button.MouseButton1Click:Connect(function()


        if Callback then

            Callback()

        end


    end)



    return Button

end





