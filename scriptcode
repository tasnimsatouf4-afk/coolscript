        local hum =
        char:FindFirstChildOfClass(
        "Humanoid"
        )


        if hum then

            workspace.CurrentCamera.CameraSubject =
            hum

        end


    end


end




local function Rejoin()


    TeleportService:Teleport(
        game.PlaceId,
