local Aura = {}
local AuraFlyGyro, AuraFlyVelocity
local AuraFlyConnection

local AnimationPacks = {
	["Angel"] = 57393899235237,
	["adidas Aura"] = 4294795,
	["adidas Community"] = 2623795,
}

function Aura.ApplyPack(packName)
	State.CurrentPack = packName
	local id = AnimationPacks[packName]
	if not id then return end

	local char = LocalPlayer.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return end

	-- Try to set movement animations on the humanoid's description so the pack is applied
	local success, err = pcall(function()
		local desc = hum:GetAppliedDescription()
		local assetStr = tostring(id)
		if not string.match(assetStr, "^rbxassetid://") then
			assetStr = "rbxassetid://" .. assetStr
		end

		-- Set common movement animations to the pack (some packs expose multiple animations under the same package id)
		desc.WalkAnimation = assetStr
		desc.RunAnimation = assetStr
		desc.IdleAnimation = assetStr
		desc.JumpAnimation = assetStr
		desc.ClimbAnimation = assetStr
		desc.FallAnimation = assetStr

		hum:ApplyDescription(desc)
	end)

	if not success then
		Log("Failed to apply animation pack: " .. tostring(err))
		Notify("Aura", "Failed to apply pack")
		return
	end

	Log("Animation Pack applied: " .. packName .. " (" .. id .. ")")
	Notify("Aura", "Pack: " .. packName)
end

function Aura.StopAuraFly()
	State.AuraFlyEnabled = false
	if AuraFlyConnection then
		AuraFlyConnection:Disconnect()
		AuraFlyConnection = nil
	end
	if AuraFlyGyro then
		AuraFlyGyro:Destroy()
		AuraFlyGyro = nil
	end
	if AuraFlyVelocity then
		AuraFlyVelocity:Destroy()
		AuraFlyVelocity = nil
	end
	local hum = GetHumanoid()
	if hum then
		hum.PlatformStand = false
	end
end

function Aura.StartAuraFly()
	Aura.StopAuraFly()
	State.AuraFlyEnabled = true

	local root = GetRoot()
	local hum = GetHumanoid()
	if not root or not hum then return end

	-- Important: Do NOT set PlatformStand = true permanently
	-- so the animation pack can still play walk/idle
	-- We only control position

	AuraFlyGyro = Create("BodyGyro", {
		P = 9e4,
		MaxTorque = Vector3.new(9e9, 9e9, 9e9),
		CFrame = root.CFrame,
		Parent = root
	})

	AuraFlyVelocity = Create("BodyVelocity", {
		Velocity = Vector3.zero,
		MaxForce = Vector3.new(9e9, 9e9, 9e9),
		Parent = root
	})

	AuraFlyConnection = RunService.Heartbeat:Connect(function()
		if not State.AuraFlyEnabled or not root or not root.Parent then
			Aura.StopAuraFly()
			return
		end

		local cam = workspace.CurrentCamera
		local move = Vector3.zero
		local speed = State.AuraFlySpeed

		if UserInputService:IsKeyDown(Enum.KeyCode.W) then
			move = move + cam.CFrame.LookVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then
			move = move - cam.CFrame.LookVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then
			move = move - cam.CFrame.RightVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then
			move = move + cam.CFrame.RightVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
			move = move + Vector3.new(0, 1, 0)
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
			move = move - Vector3.new(0, 1, 0)
		end

		if move.Magnitude > 0 then
			move = move.Unit * speed
		end

		AuraFlyVelocity.Velocity = move
		AuraFlyGyro.CFrame = CFrame.new(root.Position, root.Position + cam.CFrame.LookVector)
	end)

	Log("Aura Fly enabled")
	Notify("Aura", "Aura Fly ON")
end

AddConnection(LocalPlayer.CharacterAdded:Connect(function()
	task.wait(0.5)
	if State.AuraFlyEnabled then
		Aura.StartAuraFly()
	end
	if State.CurrentPack then
		Aura.ApplyPack(State.CurrentPack)
	end
end))

