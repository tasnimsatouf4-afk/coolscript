function Yamin.CreateTab(Name)


    local Button =
    Instance.new("TextButton")


    Button.Size =
    UDim2.new(1,-20,0,40)


    Button.BackgroundColor3 =
    Yamin.Theme.Card


    Button.Text =
    Name


    Button.TextColor3 =
    Yamin.Theme.Text


    Button.Font =
    Enum.Font.Gotham


    Button.TextSize = 16


    Button.Parent = Sidebar



    local Corner =
    Instance.new("UICorner")

    Corner.CornerRadius =
    UDim.new(0,8)

    Corner.Parent = Button



    local Page =
    Instance.new("ScrollingFrame")


    Page.Size =
    UDim2.new(1,0,1,0)

    Page.BackgroundTransparency = 1

    Page.Visible = false

    Page.ScrollBarThickness = 4

    Page.Parent = Content



    local Layout =
    Instance.new("UIListLayout")


    Layout.Padding =
    UDim.new(0,12)


    Layout.Parent = Page



    Button.MouseButton1Click:Connect(function()


        for _,tab in pairs(Yamin.Tabs) do

            tab.Visible = false

        end


        Page.Visible = true

        Yamin.CurrentTab = Page


    end)



    Yamin.Tabs[Name] = Page


    return Page

end



