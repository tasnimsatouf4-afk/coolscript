local function Notify(Message, Duration)
    Duration = Duration or 3

    local Notification = Instance.new("Frame")
    Notification.Size = UDim2.fromOffset(300, 55)
    Notification.BackgroundColor3 = Config.Card
    Notification.BorderSizePixel = 0
    Notification.Parent = NotificationHolder

    Corner(Notification, 9)
    Stroke(Notification, Config.Border, 1)

    local Line = Instance.new("Frame")
    Line.Size = UDim2.fromOffset(3, 55)
    Line.BackgroundColor3 = Config.Accent
    Line.BorderSizePixel = 0
    Line.Parent = Notification

    local Text = Instance.new("TextLabel")
    Text.Size = UDim2.new(1, -25, 1, 0)
    Text.Position = UDim2.fromOffset(15, 0)
    Text.BackgroundTransparency = 1
    Text.Text = Message
    Text.TextColor3 = Config.Text
    Text.TextSize = 13
    Text.Font = Enum.Font.Gotham
    Text.TextWrapped = true
    Text.TextXAlignment = Enum.TextXAlignment.Left
    Text.Parent = Notification

    Notification.BackgroundTransparency = 1
    Text.TextTransparency = 1
    Line.BackgroundTransparency = 1

    Tween(Notification, 0.25, {
        BackgroundTransparency = 0
    }):Play()

    Tween(Text, 0.25, {
        TextTransparency = 0
    }):Play()

    Tween(Line, 0.25, {
        BackgroundTransparency = 0
    }):Play()

    task.delay(Duration, function()
        local Out = Tween(Notification, 0.25, {
            BackgroundTransparency = 1
        })

        Tween(Text, 0.25, {
            TextTransparency = 1
        }):Play()

        Tween(Line, 0.25, {
            BackgroundTransparency = 1
        }):Play()

        Out:Play()
        Out.Completed:Wait()

        Notification:Destroy()
    end)
end

