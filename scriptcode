local SelectedPlayer = nil

local Mode = "None"

local PlayerButtons = {}



--==================================================
-- HELPERS
--==================================================

local function GetRoot(player)

    if not player then
        return
    end


    local char =
    player.Character


    if char then

        return char:FindFirstChild(
            "HumanoidRootPart"
        )

    end

end



local function GetHumanoid(player)

    if not player then
        return
    end


    local char =
    player.Character


    if char then

        return char:FindFirstChildOfClass(
            "Humanoid"
        )

    end

end



--==================================================
-- PLAYER ACTION LOOP
--==================================================

RunService.RenderStepped:Connect(
function()


    if not SelectedPlayer then
        return
    end



    if Mode == "None" then
        return
    end



    local TargetRoot =
    GetRoot(
        SelectedPlayer
    )


    local MyRoot =
    GetRoot(
        LocalPlayer
    )



    if not TargetRoot
    or not MyRoot then

        return

    end



    -- stand behind player

    if Mode == "Stalk" then


        MyRoot.CFrame =
        CFrame.lookAt(

            TargetRoot.Position
            -
            TargetRoot.CFrame.LookVector
            *
            5,

            TargetRoot.Position

        )


    end



    -- follow

    if Mode == "Follow" then


        MyRoot.CFrame =
        CFrame.lookAt(

            TargetRoot.Position
            -
            TargetRoot.CFrame.LookVector
            *
            8,

            TargetRoot.Position

        )


    end



    -- orbit

    if Mode == "Orbit" then


        local angle =
        tick()*2



        local offset =
        Vector3.new(

            math.cos(angle)*10,

            4,

            math.sin(angle)*10

        )



        MyRoot.CFrame =
        CFrame.lookAt(

            TargetRoot.Position
            +
            offset,

            TargetRoot.Position

        )


    end



end)



