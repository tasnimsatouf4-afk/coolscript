--==================================================

local function TeleportToPlayer(Target)

    if not Target then
        Notify("No player selected.")
        return
    end

    local TargetRoot = GetTargetRoot(Target)

    if not TargetRoot then
        Notify("Target character not available.")
        return
    end

    local MyRoot = GetRoot()

    if not MyRoot then
        return
    end

    MyRoot.CFrame =
        TargetRoot.CFrame *
        CFrame.new(0, 0, 4)

    Notify(
        "Teleported to " ..
        Target.DisplayName
    )
end

--==================================================
-- BRING PLAYER
--==================================================

local function BringPlayer(Target)

    if not Target then
        Notify("No player selected.")
        return
    end

    local TargetRoot = GetTargetRoot(Target)
    local MyRoot = GetRoot()

    if not TargetRoot or not MyRoot then
        Notify("Character unavailable.")
        return
    end

    TargetRoot.CFrame =
        MyRoot.CFrame *
        CFrame.new(0, 0, -4)

    Notify(
        "Brought " ..
        Target.DisplayName
    )
end

