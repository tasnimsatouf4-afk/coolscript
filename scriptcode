local PlayersModule = {}
local PlayerListFrame
local SelectedInfoLabels = {}
local PlayerButtons = {}

function PlayersModule.RefreshList(filter)
	if not PlayerListFrame then return end
	for _, child in ipairs(PlayerListFrame:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
	table.clear(PlayerButtons)

	filter = (filter or ""):lower()

	for _, plr in ipairs(Players:GetPlayers()) do
		local nameMatch = plr.Name:lower():find(filter, 1, true)
		local displayMatch = plr.DisplayName:lower():find(filter, 1, true)
		if filter == "" or nameMatch or displayMatch then
			local btn = Create("TextButton", {
				Size = UDim2.new(1, -8, 0, 34),
				BackgroundColor3 = (State.SelectedPlayer == plr) and Theme.Selected or Theme.Card,
				Text = "  " .. plr.DisplayName .. "  (@" .. plr.Name .. ")",
				TextColor3 = Theme.Text,
				Font = Enum.Font.Gotham,
				TextSize = 13,
				TextXAlignment = Enum.TextXAlignment.Left,
				AutoButtonColor = false,
				Parent = PlayerListFrame
			})
			Corner(btn, 6)

			btn.MouseEnter:Connect(function()
				if State.SelectedPlayer ~= plr then
					btn.BackgroundColor3 = Theme.Hover
				end
			end)
			btn.MouseLeave:Connect(function()
				if State.SelectedPlayer ~= plr then
					btn.BackgroundColor3 = Theme.Card
				end
			end)

			btn.MouseButton1Click:Connect(function()
				State.SelectedPlayer = plr
				PlayersModule.UpdateSelected()
				PlayersModule.RefreshList(filter)
			end)

			PlayerButtons[plr] = btn
		end
	end
end

function PlayersModule.UpdateSelected()
	local plr = State.SelectedPlayer
	if SelectedInfoLabels.Username then
		if plr and plr.Parent then
			SelectedInfoLabels.Username.Text = "Username: " .. plr.Name
			SelectedInfoLabels.DisplayName.Text = "Display Name: " .. plr.DisplayName
			SelectedInfoLabels.UserId.Text = "User ID: " .. plr.UserId
		else
			SelectedInfoLabels.Username.Text = "Username: None"
			SelectedInfoLabels.DisplayName.Text = "Display Name: —"
			SelectedInfoLabels.UserId.Text = "User ID: —"
			State.SelectedPlayer = nil
		end
	end
end

AddConnection(Players.PlayerAdded:Connect(function()
	task.wait(0.1)
	PlayersModule.RefreshList()
end))

AddConnection(Players.PlayerRemoving:Connect(function(plr)
	if State.SelectedPlayer == plr then
		State.SelectedPlayer = nil
		PlayersModule.UpdateSelected()
	end
	PlayersModule.RefreshList()
end))

