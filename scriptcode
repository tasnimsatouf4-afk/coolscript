--==================================================

local function SetWalkSpeed(speed)
    local hum = GetHumanoid()

    if not hum then
        return
    end

    MovementSettings.WalkSpeed = speed

    if not MovementSettings.Sprint then
        hum.WalkSpeed = speed
    end
end

