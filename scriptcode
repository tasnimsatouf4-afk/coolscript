--==================================================
-- PLAYER MOVEMENT LOOP
--==================================================


FollowConnection =
RunService.RenderStepped:Connect(
function()


    local target =
    PlayerSystem.Target


    local mode =
    PlayerSystem.Mode



    if not target then
        return
    end



    local targetRoot =
    GetRoot(target)


    local myRoot =
    GetRoot(LocalPlayer)



    if not targetRoot
    or not myRoot then

        return

    end



    -- STALK

    if mode == "Stalk" then


        local position =
        targetRoot.Position
        -
        targetRoot.CFrame.LookVector
        *
        4



        myRoot.CFrame =
        CFrame.lookAt(
            position,
            targetRoot.Position
        )



    end



    -- HEADSIT

    if mode == "Headsit" then


        myRoot.CFrame =
        CFrame.new(
            targetRoot.Position
            +
            Vector3.new(
                0,
                4,
                0
            )
        )


    end



    -- FOLLOW


    if mode == "Follow" then


        local position =
        targetRoot.Position
        -
        targetRoot.CFrame.LookVector
        *
        6



        myRoot.CFrame =
        CFrame.lookAt(
            position,
            targetRoot.Position
        )


    end



    -- ORBIT


    if mode == "Orbit" then


        local angle =
        tick()*2



        local offset =
        Vector3.new(

            math.cos(angle)
            *
            PlayerSystem.OrbitDistance,

            3,

            math.sin(angle)
            *
            PlayerSystem.OrbitDistance

        )



        myRoot.CFrame =
        CFrame.lookAt(
            targetRoot.Position
            +
            offset,

            targetRoot.Position

        )


    end


end)



