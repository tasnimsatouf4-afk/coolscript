function Yamin.RefreshPlayers()



    for _,button in pairs(
    Yamin.PlayerButtons
    ) do


        button:Destroy()


    end



    table.clear(
    Yamin.PlayerButtons
    )




    for _,Player in pairs(
    PlayerService:GetPlayers()
