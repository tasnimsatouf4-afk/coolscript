    TrollSettings.Orbit = false

end

--==================================================
-- POSITION CONTROLLER
--==================================================

TrollConnection = RunService.RenderStepped:Connect(function(dt)

    local target = GetTarget()

    if not target then
        return
    end

    local targetRoot = GetRoot(target)

    local localCharacter = LocalPlayer.Character
    local localRoot =
        localCharacter
        and localCharacter:FindFirstChild("HumanoidRootPart")

    if not targetRoot or not localRoot then
        return
    end

    --==============================================
    -- STALK
    --==============================================

    if TrollSettings.Stalk then

        -- Behind the player
        local position =
            targetRoot.Position
            - targetRoot.CFrame.LookVector * 3

        -- Face the target
        local targetCFrame =
            CFrame.lookAt(
                position,
                targetRoot.Position
            )

        localRoot.CFrame =
            localRoot.CFrame:Lerp(
                targetCFrame,
                math.clamp(dt * 15, 0, 1)
            )

    --==============================================
    -- HEADSIT
    --==============================================

    elseif TrollSettings.Headsit then

        local position =
            targetRoot.Position
            + Vector3.new(0, 3.2, 0)

        local targetCFrame =
            CFrame.new(
                position,
                targetRoot.Position
            )

        localRoot.CFrame =
            localRoot.CFrame:Lerp(
                targetCFrame,
                math.clamp(dt * 18, 0, 1)
            )

    --==============================================
    -- FOLLOW
    --==============================================

    elseif TrollSettings.Follow then

        local desiredPosition =
            targetRoot.Position
            - targetRoot.CFrame.LookVector
            * TrollSettings.FollowDistance

        localRoot.CFrame =
            localRoot.CFrame:Lerp(
                CFrame.lookAt(
                    desiredPosition,
                    targetRoot.Position
                ),
                math.clamp(dt * 8, 0, 1)
            )

    --==============================================
    -- ORBIT
    --==============================================

    elseif TrollSettings.Orbit then

        local time = os.clock()

        local angle = time * 2

        local offset =
            Vector3.new(
                math.cos(angle)
                    * TrollSettings.OrbitDistance,

                TrollSettings.OrbitHeight,

                math.sin(angle)
                    * TrollSettings.OrbitDistance
            )

        local position =
            targetRoot.Position + offset

        localRoot.CFrame =
            localRoot.CFrame:Lerp(
                CFrame.lookAt(
                    position,
                    targetRoot.Position
                ),
                math.clamp(dt * 10, 0, 1)
            )
    end
end)

