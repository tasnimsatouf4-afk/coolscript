    Minimized = false,

    Key = Enum.KeyCode.RightShift

}



--==================================================
-- TOGGLE GUI
--==================================================

local function ToggleGUI()


    Settings.Visible =
    not Settings.Visible


    if Gui then

        Gui.Enabled =
        Settings.Visible

    end


end



--==================================================
-- MINIMIZE
--==================================================

local Main =
Gui:FindFirstChildWhichIsA(
"Frame"
)



local function Minimize()


    if not Main then
        return
    end



    Settings.Minimized =
    not Settings.Minimized



    if Settings.Minimized then


        Main.Size =
        UDim2.fromOffset(
            750,
            45
        )


    else


        Main.Size =
        UDim2.fromOffset(
            750,
            480
        )


    end


end



--==================================================
-- KEYBIND
--==================================================


UserInputService.InputBegan:Connect(
function(input,gpe)


    if gpe then
        return
    end



    if input.KeyCode ==
    Settings.Key then


        ToggleGUI()


    end


end)



