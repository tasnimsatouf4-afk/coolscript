local HubSettings = {
    Notifications = true,
    AnimationEffects = true,
    UIVisible = true,
    CameraFOV = 70,
}

--==================================================
-- NOTIFICATION OVERRIDE
--==================================================

local OriginalNotify = Notify

Notify = function(Message, Duration)
    if not HubSettings.Notifications then
        return
    end

    OriginalNotify(Message, Duration)
end

--==================================================
-- CAMERA
--==================================================

local DefaultFOV = 70

local function SetFOV(Value)
    Value = math.clamp(Value, 40, 120)

    HubSettings.CameraFOV = Value

    local Camera = workspace.CurrentCamera

    if Camera then
        Camera.FieldOfView = Value
    end
end

local function ResetCamera()
    HubSettings.CameraFOV = DefaultFOV

    local Camera = workspace.CurrentCamera

    if Camera then
        Camera.FieldOfView = DefaultFOV
    end

    Notify("Camera reset.")
end

--==================================================
-- ANIMATION
--==================================================

local CurrentAnimationTrack = nil

local function StopAnimation()
    if CurrentAnimationTrack then
        pcall(function()
            CurrentAnimationTrack:Stop()
            CurrentAnimationTrack:Destroy()
        end)

        CurrentAnimationTrack = nil
    end
end

local function PlayAnimation(AnimationId)

    if not HubSettings.AnimationEffects then
        return
    end

    local Hum = GetHumanoid()

    if not Hum then
        return
    end

    local Animator = Hum:FindFirstChildOfClass("Animator")

    if not Animator then
        Animator = Instance.new("Animator")
        Animator.Parent = Hum
    end

    StopAnimation()

    local Animation = Instance.new("Animation")
    Animation.AnimationId = "rbxassetid://" .. tostring(AnimationId)

    local Success, Track = pcall(function()
        return Animator:LoadAnimation(Animation)
    end)

    Animation:Destroy()

    if not Success or not Track then
        Notify("Could not load animation.")
        return
    end

    Track.Looped = true
    Track:Play()

    CurrentAnimationTrack = Track
end

--==================================================
-- AURA
--==================================================

local AuraObjects = {}

local function RemoveAura()

    for _, Object in ipairs(AuraObjects) do
        if Object and Object.Parent then
            Object:Destroy()
        end
    end

    table.clear(AuraObjects)
end

local function CreateAura(Type)

    RemoveAura()

    if not Character or not Character.Parent then
        UpdateCharacter()
    end

    local RootPart = GetRoot()

    if not RootPart then
        return
    end

    if Type == "Fire" then

        local Fire = Instance.new("Fire")
        Fire.Name = "YaminFireAura"
        Fire.Size = 8
        Fire.Heat = 8
        Fire.Parent = RootPart

        table.insert(AuraObjects, Fire)

    elseif Type == "Smoke" then

        local Smoke = Instance.new("Smoke")
        Smoke.Name = "YaminSmokeAura"
        Smoke.Size = 8
        Smoke.RiseVelocity = 5
        Smoke.Opacity = 0.35
        Smoke.Parent = RootPart

        table.insert(AuraObjects, Smoke)

    elseif Type == "Sparkles" then

        local Sparkles = Instance.new("Sparkles")
        Sparkles.Name = "YaminSparklesAura"
        Sparkles.SparkleColor = Config.Accent
        Sparkles.Parent = RootPart

        table.insert(AuraObjects, Sparkles)

    elseif Type == "ForceField" then

        local ForceField = Instance.new("ForceField")
        ForceField.Name = "YaminForceField"
        ForceField.Visible = true
        ForceField.Parent = Character

        table.insert(AuraObjects, ForceField)

    elseif Type == "Highlight" then

        local Highlight = Instance.new("Highlight")
        Highlight.Name = "YaminAuraHighlight"
        Highlight.FillColor = Config.Accent
        Highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        Highlight.FillTransparency = 0.45
        Highlight.OutlineTransparency = 0
        Highlight.Parent = Character

        table.insert(AuraObjects, Highlight)
    end

    Notify(Type .. " aura enabled.")
end

