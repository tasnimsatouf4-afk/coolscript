local function GetPlayerByName(Name)
    if not Name then
        return nil
    end

    Name = string.lower(Name)

    for _, Target in ipairs(Players:GetPlayers()) do
        if string.lower(Target.Name) == Name
            or string.lower(Target.DisplayName) == Name then
            return Target
        end
    end

    return nil
end

local function GetTargetCharacter(Target)
    if not Target then
        return nil
    end

    return Target.Character
end

local function GetTargetRoot(Target)
    local TargetCharacter = GetTargetCharacter(Target)

    if not TargetCharacter then
        return nil
    end

    return TargetCharacter:FindFirstChild("HumanoidRootPart")
end

local function GetTargetHumanoid(Target)
    local TargetCharacter = GetTargetCharacter(Target)

    if not TargetCharacter then
        return nil
    end

    return TargetCharacter:FindFirstChildOfClass("Humanoid")
end

