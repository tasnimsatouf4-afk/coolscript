--==================================================
-- FLY ENGINE
--==================================================

local FlyConnection
local FlyVelocity = Vector3.zero

local function StopFly()
    MovementSettings.Fly = false

    if FlyConnection then
        FlyConnection:Disconnect()
        FlyConnection = nil
    end

    local hum = GetHumanoid()
    local root = GetRoot()

    if hum then
        hum.PlatformStand = false
        hum.AutoRotate = true
    end

    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end

    FlyVelocity = Vector3.zero
end

local function StartFly()
    if MovementSettings.Fly then
        return
    end

    if not RefreshCharacter() then
        Yamin.Notify("Fly", "Character is not ready.")
        return
    end

    local hum = Humanoid
    local root = RootPart

    MovementSettings.Fly = true
    FlyVelocity = Vector3.zero

    hum.AutoRotate = false
    hum.PlatformStand = true

    FlyConnection = RunService.RenderStepped:Connect(function(dt)

        if not MovementSettings.Fly then
            return
        end

        if not Character
            or not Character.Parent
            or not Humanoid
            or Humanoid.Health <= 0
            or not RootPart
            or not RootPart.Parent then

            StopFly()
            return
        end

        local camera = workspace.CurrentCamera

        if not camera then
            return
        end

        -- Camera-relative directions
        local forward = camera.CFrame.LookVector
        local right = camera.CFrame.RightVector
        local up = camera.CFrame.UpVector

        local direction = Vector3.zero

        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            direction += forward
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            direction -= forward
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            direction += right
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            direction -= right
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            direction += up
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
            or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then

            direction -= up
        end

        if direction.Magnitude > 0 then
            direction = direction.Unit
        end

        -- Smooth acceleration
        local targetVelocity =
            direction * MovementSettings.FlySpeed

        local acceleration =
            math.clamp(
                MovementSettings.FlyAcceleration * dt * 10,
                0,
                1
            )

        FlyVelocity =
            FlyVelocity:Lerp(targetVelocity, acceleration)

        --==================================================
        -- WALL / OBSTACLE DETECTION
        --==================================================

        local moveVector = FlyVelocity * dt

        if moveVector.Magnitude > 0 then

            local rayParams = RaycastParams.new()

            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.FilterDescendantsInstances = {Character}
            rayParams.IgnoreWater = true

            local result = workspace:Raycast(
                RootPart.Position,
                moveVector,
                rayParams
            )

            if result then
                -- Remove velocity going directly into the wall
                local normal = result.Normal

                local intoWall =
                    FlyVelocity:Dot(normal)

                if intoWall < 0 then
                    FlyVelocity =
                        FlyVelocity - normal * intoWall
                end

                moveVector = FlyVelocity * dt

                -- Prevent crossing the detected obstacle
                local distance = (
                    result.Position - RootPart.Position
                ).Magnitude

                local allowedDistance =
                    math.max(distance - 1.5, 0)

                if moveVector.Magnitude > allowedDistance then
                    moveVector =
                        moveVector.Unit * allowedDistance
                end
            end
        end

        --==================================================
        -- MOVE CHARACTER
        --==================================================

        local newPosition =
            RootPart.Position + moveVector

        --==================================================
        -- FACE FLIGHT DIRECTION
        --==================================================

        local lookDirection

        if FlyVelocity.Magnitude > 0.5 then
            lookDirection = FlyVelocity.Unit
        else
            lookDirection = camera.CFrame.LookVector
        end

        local targetCFrame =
            CFrame.lookAt(
                newPosition,
                newPosition + lookDirection,
                Vector3.yAxis
            )

        RootPart.CFrame =
            RootPart.CFrame:Lerp(
                targetCFrame,
                math.clamp(dt * 12, 0, 1)
            )

        RootPart.AssemblyLinearVelocity = Vector3.zero
        RootPart.AssemblyAngularVelocity = Vector3.zero
    end)
end

local function SetFly(enabled)
    if enabled then
        StartFly()
    else
        StopFly()
    end
end

