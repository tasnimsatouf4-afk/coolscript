--==================================================
-- AURA FLY
--==================================================

local FlyConnection
local FlyVelocity = Vector3.zero

local OldAutoRotate = true
local OldPlatformStand = false

local function StopAuraFly()

    AuraSettings.AuraFly = false

    if FlyConnection then

        FlyConnection:Disconnect()
        FlyConnection = nil

    end

    StopAnimation()

    if Humanoid then

        Humanoid.AutoRotate =
            OldAutoRotate

        Humanoid.PlatformStand =
            OldPlatformStand

    end

    if Root then

        Root.AssemblyLinearVelocity =
            Vector3.zero

        Root.AssemblyAngularVelocity =
            Vector3.zero

    end

    FlyVelocity =
        Vector3.zero

    CurrentFlyState = ""

end

local function StartAuraFly()

    if AuraSettings.AuraFly then
        return
    end

    if not RefreshCharacter() then

        Yamin.Notify(
            "Aura Fly",
            "Character not ready."
        )

        return

    end

    OldAutoRotate =
        Humanoid.AutoRotate

    OldPlatformStand =
        Humanoid.PlatformStand

    AuraSettings.AuraFly = true

    Humanoid.AutoRotate = false
    Humanoid.PlatformStand = true

    FlyVelocity =
        Vector3.zero

    CurrentFlyState = ""

    SetFlyAnimation("Hover")

    FlyConnection =
        RunService.RenderStepped:Connect(
            function(dt)

                if not AuraSettings.AuraFly then
                    return
                end

                if not Character
                    or not Character.Parent
                    or not Humanoid
                    or Humanoid.Health <= 0
                    or not Root
                    or not Root.Parent then

                    StopAuraFly()
                    return

                end

                local Camera =
                    workspace.CurrentCamera

                if not Camera then
                    return
                end

                --========================================
                -- CAMERA DIRECTIONS
                --========================================

                local Forward =
                    Camera.CFrame.LookVector

                local Right =
                    Camera.CFrame.RightVector

                local Up =
                    Camera.CFrame.UpVector

                local Direction =
                    Vector3.zero

                -- W

                if UserInputService:IsKeyDown(
                    Enum.KeyCode.W
                ) then

                    Direction += Forward

                end

                -- S

                if UserInputService:IsKeyDown(
                    Enum.KeyCode.S
                ) then

                    Direction -= Forward

                end

                -- D

                if UserInputService:IsKeyDown(
                    Enum.KeyCode.D
                ) then

                    Direction += Right

                end

                -- A

                if UserInputService:IsKeyDown(
                    Enum.KeyCode.A
                ) then

                    Direction -= Right

                end

                -- SPACE

                if UserInputService:IsKeyDown(
                    Enum.KeyCode.Space
                ) then

                    Direction += Up

                end

                -- CTRL

                if UserInputService:IsKeyDown(
                    Enum.KeyCode.LeftControl
                ) then

                    Direction -= Up

                end

                if Direction.Magnitude > 0 then
                    Direction = Direction.Unit
                end

                --========================================
                -- SPEED
                --========================================

                local TargetVelocity =
                    Direction
                    * AuraSettings.FlySpeed

                local Alpha =
                    math.clamp(
                        AuraSettings.Acceleration
                        * dt
                        * 10,
                        0,
                        1
                    )

                FlyVelocity =
                    FlyVelocity:Lerp(
                        TargetVelocity,
                        Alpha
                    )

                --========================================
                -- STATE
                --========================================

                local State = "Hover"

                if Direction.Magnitude > 0.05 then

                    local Relative =
                        Camera.CFrame:VectorToObjectSpace(
                            Direction
                        )

                    if Relative.Y > 0.55 then

                        State = "Up"

                    elseif Relative.Y < -0.55 then

                        State = "Down"

                    elseif Relative.Z < -0.55 then

                        State = "Forward"

                    elseif Relative.Z > 0.55 then

                        State = "Backward"

                    elseif Relative.X > 0.55 then

                        State = "Right"

                    elseif Relative.X < -0.55 then

                        State = "Left"

                    end

                end

                SetFlyAnimation(State)

                --========================================
                -- WALL CHECK
                --========================================

                local Movement =
                    FlyVelocity * dt

                if Movement.Magnitude > 0 then

                    local Params =
                        RaycastParams.new()

                    Params.FilterType =
                        Enum.RaycastFilterType.Exclude

                    Params.FilterDescendantsInstances = {
                        Character
                    }

                    Params.IgnoreWater = true

                    local Hit =
                        workspace:Raycast(
                            Root.Position,
                            Movement,
                            Params
                        )

                    if Hit then

                        local Normal =
                            Hit.Normal

                        local IntoWall =
                            FlyVelocity:Dot(Normal)

                        if IntoWall < 0 then

                            FlyVelocity =
                                FlyVelocity
                                - Normal * IntoWall

                        end

                        Movement =
                            FlyVelocity * dt

                    end

                end

                --========================================
                -- MOVE
                --========================================

                local NewPosition =
                    Root.Position + Movement

                local LookDirection

                if FlyVelocity.Magnitude > 0.5 then

                    LookDirection =
                        FlyVelocity.Unit

                else

                    LookDirection =
                        Camera.CFrame.LookVector

                end

                local TargetCFrame =
                    CFrame.lookAt(
                        NewPosition,
                        NewPosition + LookDirection,
                        Vector3.yAxis
                    )

                Root.CFrame =
                    Root.CFrame:Lerp(
                        TargetCFrame,
                        math.clamp(dt * 12, 0, 1)
                    )

                Root.AssemblyLinearVelocity =
                    Vector3.zero

                Root.AssemblyAngularVelocity =
                    Vector3.zero

            end
        )

end

